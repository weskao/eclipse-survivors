# Optional override. The dedicated project's public web config ships in src/cloud/firebase-config.ts;
# set this only to point at another project (e.g. the emulator demo config).
# No OAuth client secret or service account key belongs in a Vite environment variable.
# VITE_ES2_FIREBASE_CONFIG='{"apiKey":"","authDomain":"","projectId":"","appId":""}'

# ES4 master switch (all Vite modes): 0 = original five research nodes; 1 = ES4 preview / isolated unlocked DEV gameplay.
VITE_ES4_HALL=1
